# Copy to .env.local (local dev) and add the same values in Vercel → Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
# Optional: which deployment the iOS/Android shell loads (default https://castit.vercel.app)
CASTIT_APP_URL=https://castit.vercel.app
